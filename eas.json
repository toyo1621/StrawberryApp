{
  "cli": {
    "version": "19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RANKINGS_API_URL": "https://strawberry-rankings-api.toyo1621.workers.dev"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_RANKINGS_API_URL": ""
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RANKINGS_API_URL": "https://strawberry-rankings-api.toyo1621.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
